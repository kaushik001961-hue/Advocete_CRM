generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  image     String?
  role      Role      @default(ADVOCATE)
  accounts  Account[]
  cases     Case[]    @relation("AdvocateCases")
  sessions  Session[]
  tasks     Task[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  email     String?    @unique
  address   String?
  createdAt DateTime   @default(now())
  city      String?
  notes     String?
  pincode   String?
  state     String?
  updatedAt DateTime   @updatedAt
  cases     Case[]
  documents Document[]
  invoices  Invoice[]
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  category    String
  expenseDate DateTime
  createdAt   DateTime @default(now())
  description String?
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("PENDING")
  assignedTo  String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [assignedTo], references: [id])
}

model Case {
  id          String     @id @default(cuid())
  title       String
  court       String
  status      String
  clientId    String
  advocateId  String
  createdAt   DateTime   @default(now())
  caseNumber  String
  description String?
  filingDate  DateTime?
  priority    String?    @default("NORMAL")
  advocate    User       @relation("AdvocateCases", fields: [advocateId], references: [id])
  client      Client     @relation(fields: [clientId], references: [id])
  documents   Document[]
  hearings    Hearing[]
}

model Hearing {
  id          String    @id @default(cuid())
  date        DateTime
  remarks     String?
  caseId      String
  nextDate    DateTime?
  status      String    @default("SCHEDULED")
  courtRoom   String?
  createdAt   DateTime  @default(now())
  hearingType String?
  orderPassed String?
  case        Case      @relation(fields: [caseId], references: [id])
}

model Document {
  id         String   @id @default(cuid())
  fileUrl    String
  clientId   String?
  caseId     String?
  category   String?
  fileSize   Int?
  mimeType   String?
  name       String
  uploadedAt DateTime @default(now())
  case       Case?    @relation(fields: [caseId], references: [id])
  client     Client?  @relation(fields: [clientId], references: [id])
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique
  clientId    String
  amount      Float
  gstAmount   Float
  totalAmount Float
  dueDate     DateTime
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  notes       String?
  client      Client   @relation(fields: [clientId], references: [id])
}

enum Role {
  ADMIN
  ADVOCATE
  STAFF
}
