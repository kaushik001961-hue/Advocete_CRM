generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  password             String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  image                String?
  role                 Role      @default(ADVOCATE)
  barEnrollmentNo      String?   @unique
  experienceYears      Int?      @default(0)
  phone                String?
  specialisation       String?
  status               String    @default("Active")

  emailNotifications   Boolean   @default(true)
  whatsappNotifications Boolean  @default(true)

  accounts             Account[]
  cases                Case[]    @relation("AdvocateCases")
  sessions             Session[]
  notifications        Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  email     String?    @unique
  address   String?
  createdAt DateTime   @default(now())
  city      String?
  notes     String?
  pincode   String?
  state     String?
  updatedAt DateTime   @default(now()) @updatedAt
  cases     Case[]
  documents Document[]
  invoices  Invoice[]
  portalAccount ClientPortalAccount?
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  category    String
  expenseDate DateTime
  createdAt   DateTime @default(now())
  description String?
}

model ClientPortalAccount {
  id           String   @id @default(cuid())
  clientId     String   @unique
  email        String   @unique
  passwordHash String
  enabled      Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([email])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String   @default("PENDING")
  assignedTo  String?
  createdAt   DateTime @default(now())

  @@index([dueDate])
  @@index([status])
  @@index([assignedTo])
}

model Case {
  id                 String              @id @default(cuid())
  title              String
  court              String
  status             String              @default("ACTIVE")
  clientId           String
  advocateId         String
  createdAt          DateTime            @default(now())
  caseNumber         String              @unique

cnrNumber           String?   @unique
eCourtsStatus       String?
eCourtsLastSyncedAt DateTime?

  description        String?
  filingDate         DateTime?
  priority           String?             @default("NORMAL")
  counselPhone       String?
  opposingCounsel    String?
  updatedAt          DateTime?           @updatedAt
  caseType           String
  caseStage          String              @default("FILED")
  registrationNumber String?
  registrationDate   DateTime?
  opposingParty      String?
  bench              String?
  presidingJudge     String?
  courtRoom          String?
  firNumber          String?
  firDate            DateTime?
  policeStation      String?
  sectionsActs       String?
  tags               String?
  advocate           User                @relation("AdvocateCases", fields: [advocateId], references: [id])
  client             Client              @relation(fields: [clientId], references: [id])
  importantDates     CaseImportantDate[]
  notes              CaseNote[]
  relatedFrom        CaseRelation[]      @relation("CaseRelationsFrom")
  relatedTo          CaseRelation[]      @relation("CaseRelationsTo")
  timelineEvents     CaseTimelineEvent[]
  documents          Document[]
  hearings           Hearing[]
  invoices           Invoice[]
}

model CaseTimelineEvent {
  id          String   @id @default(cuid())
  caseId      String
  eventType   String
  title       String
  description String?
  eventDate   DateTime
  createdAt   DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([caseId])
  @@index([eventDate])
}

model CaseImportantDate {
  id          String   @id @default(cuid())
  caseId      String
  title       String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([caseId])
  @@index([date])
}

model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([caseId])
}

model CaseRelation {
  id            String   @id @default(cuid())
  caseId        String
  relatedCaseId String
  relationType  String
  createdAt     DateTime @default(now())
  case          Case     @relation("CaseRelationsFrom", fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  relatedCase   Case     @relation("CaseRelationsTo", fields: [relatedCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([caseId, relatedCaseId])
  @@index([caseId])
  @@index([relatedCaseId])
}

model Hearing {
  id          String    @id @default(cuid())
  date        DateTime
  remarks     String?
  caseId      String
  nextDate    DateTime?
  status      String    @default("SCHEDULED")
  courtRoom   String?
  createdAt   DateTime  @default(now())
  hearingType String?
  orderPassed String?
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Document {
  id           String    @id @default(cuid())
  fileUrl      String
  clientId     String?
  caseId       String?
  category     String?
  fileSize     Int?
  mimeType     String?
  name         String
  uploadedAt   DateTime  @default(now())
  subcategory  String?
  description  String?
  documentDate DateTime?
  isImportant  Boolean   @default(false)
  updatedAt    DateTime? @updatedAt
  case         Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client       Client?   @relation(fields: [clientId], references: [id])

  @@index([caseId])
  @@index([clientId])
  @@index([category])
  @@index([documentDate])
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique
  clientId    String
  amount      Float
  gstAmount   Float
  totalAmount Float
  dueDate     DateTime
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  notes       String?
  caseId      String?
  legalCase   Case?    @relation(fields: [caseId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
}

model Notification {
  id              String    @id @default(cuid())

  userId          String

  type            String
  title           String
  message         String

  data            String?

  readAt          DateTime?

  emailStatus     String    @default("PENDING")
  whatsappStatus  String    @default("PENDING")

  emailSentAt     DateTime?
  whatsappSentAt  DateTime?

  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([emailStatus])
  @@index([whatsappStatus])
}


enum Role {
  ADMIN
  ADVOCATE
  STAFF
}
